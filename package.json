{
  "name": "banana-memory",
  "version": "0.3.1",
  "description": "Local, source-grounded project memory over Streamable HTTP MCP",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kilerd/banana-memory.git"
  },
  "homepage": "https://github.com/Kilerd/banana-memory#readme",
  "keywords": [
    "mcp",
    "memory",
    "agent-skills",
    "claude-code",
    "local-first"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "files": [
    "dist/src/",
    "models/",
    "skills/banana-memory/",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "overrides": {
    "sharp": "0.35.4"
  },
  "engines": {
    "node": ">=22.23.1"
  },
  "bin": {
    "banana-memory": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:service": "tsx --test tests/service.test.ts",
    "probe:storage": "tsx scripts/storage-probe.ts",
    "evaluate:models": "tsx scripts/evaluate-models.ts",
    "evaluate:pipeline": "tsx scripts/evaluate-local-pipeline.ts",
    "evaluate:replay": "tsx scripts/evaluate-replay.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "package": "node scripts/package.mjs",
    "site": "node scripts/serve-site.mjs"
  },
  "dependencies": {
    "@lancedb/lancedb": "0.38.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "apache-arrow": "18.1.0",
    "proper-lockfile": "4.1.2",
    "sharp": "0.35.4",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
